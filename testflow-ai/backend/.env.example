# Copy to .env and fill in for local development. Never commit real secrets.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (AD-005).
DATABASE_URL=postgres://testflow:testflow@localhost:5432/testflow

# Frontend origin allowed to make credentialed requests (CORS).
CORS_ORIGIN=http://localhost:3000

# Paystack (Slice 1 — see architecture-decisions.md AD-028, which supersedes
# AD-027/Stripe). Get a test-mode secret key from
# https://dashboard.paystack.com/#/settings/developer. The same secret key is
# used both to call the API and to verify webhook signatures — Paystack has no
# separate webhook secret. A safe placeholder is used if unset — real
# monthly/yearly payment testing requires a real Paystack *test-mode* key.
PAYSTACK_SECRET_KEY=sk_test_...

# E2E test-only (Slice 1 E2E closure). Leave unset/false for normal development —
# the E2E suite (e2e/) sets this to true itself when it starts the backend.
# NEVER set true in any real environment: it bypasses the real Paystack call and
# mounts a test-only reconciliation endpoint (see modules/testSupport).
E2E_FAKE_PAYMENTS=false

# Resend (see architecture-decisions.md AD-029). Get an API key from
# https://resend.com/api-keys. A safe placeholder is used if unset — the
# automated test suite never sends real email regardless (NODE_ENV=test skips
# delivery, see lib/email.ts), but real signup/payment-confirmation emails in
# normal local development require a real Resend API key.
RESEND_API_KEY=re_...
# Sender address — Resend's shared `onboarding@resend.dev` needs no domain
# verification, so this default works without any extra Resend setup.
EMAIL_FROM_ADDRESS=TestFlow <onboarding@resend.dev>
