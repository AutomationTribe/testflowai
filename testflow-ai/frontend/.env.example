# Copy to .env.local for local development. Never commit real secrets.

# Backend API base URL (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Paystack public key (safe to expose client-side) — Slice 1 (AD-028, supersedes
# AD-027/Stripe). Get a test-mode key from
# https://dashboard.paystack.com/#/settings/developer. Must correspond to the same
# Paystack account as the backend's PAYSTACK_SECRET_KEY.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# E2E test-only (Slice 1 E2E closure). Leave unset/false for normal development —
# the E2E suite (e2e/) sets this to true itself when it starts the frontend.
NEXT_PUBLIC_E2E_FAKE_PAYMENTS=false
